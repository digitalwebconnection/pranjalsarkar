# MongoDB Connection
MONGODB_URI=

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Admin Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
JWT_SECRET=creasun_super_secret_jwt_key_2025

# Email (Gmail SMTP) - for OTP password reset
EMAIL_USER=
EMAIL_PASS=

# Lead CRM Email Configuration
INTERNAL_NOTIFICATION_EMAIL=support@productleadership.studio
# External email for mentee confirmation (falls back to EMAIL_USER if not set)
# EXTERNAL_EMAIL_USER=office@pranjalsarkar.com
# EXTERNAL_EMAIL_PASS=




