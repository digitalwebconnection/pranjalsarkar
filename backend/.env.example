# MongoDB Connection
MONGODB_URI=

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Admin Credentials
# IMPORTANT: Use a strong, unique password. Never reuse across environments.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT Secret — generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Email Configuration (Brevo)
# Obtain these from your Brevo Dashboard
BREVO_API_KEY_NEW_LEAD=
BREVO_API_KEY_CONVERTED=


# Error Tracking (optional)
# SENTRY_DSN=