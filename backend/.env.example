# MongoDB Connection
MONGODB_URI=

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# Admin Credentials
# IMPORTANT: Use a strong, unique password. Never reuse across environments.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# JWT Secret — generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# Email (Gmail SMTP) — use an App Password, not your real Gmail password.
# See: https://support.google.com/accounts/answer/185833
EMAIL_USER=
EMAIL_PASS=

# Lead CRM Email Configuration
INTERNAL_NOTIFICATION_EMAIL=support@productleadership.studio
# External email for mentee confirmation (falls back to EMAIL_USER if not set)
# EXTERNAL_EMAIL_USER=office@pranjalsarkar.com
# EXTERNAL_EMAIL_PASS=

# Error Tracking (optional)
# SENTRY_DSN=